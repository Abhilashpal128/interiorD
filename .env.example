# Copy to .env to use the deployed mail backend during local development.
# Production builds use the same URL from the tracked .env.production file.
# To use a local backend instead, leave VITE_API_URL empty (Vite proxies /api to port 5000).
# NOTE: only non-secret values belong in VITE_ variables - they are visible in the browser.
VITE_API_URL=https://sndserver-jet.vercel.app
