# Frontend only. Leave empty locally (Vite proxies /api to http://localhost:5000).
# Run the backend with: cd mail-server && npm install && npm run dev
# In production, use the mail-server Vercel deployment's base URL, WITHOUT /api/leads:
# VITE_API_URL=https://your-mail-server.vercel.app
# Rebuild/redeploy the frontend after setting this value.
# Gmail credentials belong ONLY in mail-server/.env or the backend Vercel project.
# Never put an app password in a VITE_ variable: these are public in the browser.
VITE_API_URL=
