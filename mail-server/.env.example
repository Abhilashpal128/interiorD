# Backend only. Set these in the mail-server Vercel project's Environment Variables.
GMAIL_USER=sndbuildsolution@gmail.com
# The Google App Password for GMAIL_USER. Never use a VITE_ prefix for this secret.
GMAIL_APP_PASSWORD=
# Exact frontend origin(s), separated by commas. No paths or wildcards.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local development only; Vercel provides its own HTTP server.
PORT=5000
